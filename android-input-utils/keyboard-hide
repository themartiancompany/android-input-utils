_bin="$(
  dirname \
    "$(command \
         -v \
	 "env")")"
_lib="${_bin}/../lib"
_share="${_bin}/../share"
_crash_bash="${_lib}/libcrash-bash/crash-bash"
_sourced \
  "${_crash_bash}" \
  2>"/dev/null" \
  1>"/dev/null" || \
source \
  "${_crash_bash}"

_root_requirements() {
  _check_cmd \
    "sdotool"
}

# shellcheck disable=SC2034
_global_variables() {
  launch_date=""
  launch_mode=""
  color=""
  quiet=""
}

_keyboard_hide() {
  local \
    _mode="${1}" \
    _sdotool_opts=()
  if [[ "${_mode}" == "sdotool" ]]; then
    if [[ "${quiet}" == "n" ]]; then
      _sdotool_opts+=(
        -v
      )
    fi
    # sdotool \
    #   "${_sdotool_opts[@]}" \
    #   key \
    #     "escape"
    # Note:
    #   I don't remember
    #   if really on Android <13 the
    #   'escape' button was able
    #   to hide a virtual keyboard,
    #   anyway from Android
    #   >=13 it's more reliable
    #   to press the back button.
    #   Probably I should write
    #   an 'android -v' command
    #   which returns the android
    #   version one can like
    #   select the correct one.
    #   I have done one for the
    #   sdk version but I've
    #   forgotten the association
    #   between the android sdk
    #   version and android version
    #   at this time.
    sdotool \
      "${_sdotool_opts[@]}" \
      key \
        "escape"
  else
    _msg=(
      "Unknown mode '${_mode}'."
      "Valid values for launch"
      "mode are 'sdotool'."
    )
    _msg_error \
      "${_msg[*]}" \
      1
  fi

}

_set_overrides() {
  if [[ -v override_color ]]; then
    color="${override_color}"
  elif [[ -z "${color}" ]]; then
    color="n"
  fi
  if [[ -v override_quiet ]]; then
    quiet="${override_quiet}"
  elif [[ -z "${quiet}" ]]; then
    quiet="y"
  fi
  _set_override \
    "launch" \
    "date" \
    "$(_get_date_human)"
  _set_override \
    "launch" \
    "mode" \
    "sdotool"
}

# Shows configuration options.
_show_config() {
  _msg_info "${app_name} configuration"
  _msg_info "              Launch date:   ${launch_date}"
  _msg_info "              Launch mode:   ${launch_mode}"
}

# Show help usage, with an exit status.
# $1: exit status number.
_usage() {
  local \
    _exit_code="${1}" \
    _usage_text
  IFS='' \
    read \
      -r \
      -d '' \
      _usage_text << \
        ENDUSAGETEXT || true

Shows an Android virtual keyboard.

Usage:

  ${app_name}
    [options]

  options:

     -m <mode>                   Method to use to show keyboard.
                                 It can be:
                                 - sdotool.
                                 Default: ${launch_mode}

     -h                          This message.
     -v                          Enable verbose output

ENDUSAGETEXT
  _printf \
    '%s\n' \
    "${_usage_text}"
  exit \
    "${_exit_code}"
}

_globals
_global_variables
# shellcheck disable=SC2004
# shellcheck disable=SC2034
while \
  getopts \
    'm:vh?' \
    arg; do
  case \
    "${arg}" in
    m)
      override_launch_mode="${OPTARG}" ;;
    v)
      override_quiet="n" ;;
    h|?)
      _set_overrides
      _usage \
        0 ;;
    *)
      _msg=(
        "Invalid argument '${arg}'."
      )
      _msg_error \
        "${_msg[*]}" \
        0
      _set_overrides
      _usage \
        1 ;;
  esac
done
shift \
  $((
    OPTIND - 1 \
  ))
_set_overrides
app_opts=(
  "${launch_mode}"
)
_show_config
_keyboard_hide \
  "${app_opts[@]}"

